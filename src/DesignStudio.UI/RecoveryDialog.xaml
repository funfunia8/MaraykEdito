<Window x:Class="DesignStudio.UI.RecoveryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="560"
        SizeToContent="Height"
        MinHeight="280"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Border Padding="28">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="24"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=Title}"
                       FontSize="22"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"/>

            <TextBlock x:Name="MessageTextBlock"
                       Grid.Row="2"
                       FontSize="15"
                       TextWrapping="Wrap"/>

            <TextBlock x:Name="PathTextBlock"
                       Grid.Row="4"
                       FontSize="13"
                       TextWrapping="Wrap"/>

            <TextBlock x:Name="TimestampTextBlock"
                       Grid.Row="6"
                       FontSize="13"
                       TextWrapping="Wrap"/>

            <StackPanel Grid.Row="8"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button x:Name="RestoreButton"
                        Width="120"
                        Height="36"
                        Margin="0,0,10,0"
                        IsDefault="True"
                        Click="RestoreButton_Click"/>
                <Button x:Name="DiscardButton"
                        Width="120"
                        Height="36"
                        IsCancel="False"
                        Click="DiscardButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
