<Window x:Class="DesignStudio.UI.ProductionDrawingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Production Drawing Preview"
        Width="1200"
        Height="850"
        MinWidth="900"
        MinHeight="650"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="12">
            <Button Content="Save SVG"
                    Width="110"
                    Height="32"
                    HorizontalAlignment="Right"
                    DockPanel.Dock="Right"
                    Click="SaveSvg_Click"/>

            <StackPanel Orientation="Vertical">
                <TextBlock x:Name="HeaderText"
                           FontSize="18"
                           FontWeight="SemiBold"/>
                <TextBlock Text="Generated from the current Production Documentation pipeline."
                           Opacity="0.65"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1"
                Margin="12,0,12,12"
                BorderBrush="Gray"
                BorderThickness="1"
                Background="#E9E9E9">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto">
                <Viewbox Stretch="Uniform"
                         StretchDirection="Both"
                         Margin="24">
                    <Canvas x:Name="DrawingCanvas"
                            Width="420"
                            Height="297"
                            Background="White"/>
                </Viewbox>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
